ENV=development

# Preencha após criar o projeto no Supabase (Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Origens permitidas para o frontend (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
# Em produção, informe somente hosts públicos, sem protocolo. Ex. api.oralcardio.com.br
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Localmente os docs ficam ativos; em produção o padrão é desativado.
EXPOSE_API_DOCS=true

# Fase 4 — Web Push. Gere um par VAPID exclusivo para cada ambiente.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:contato@example.com
WEB_PUSH_VAPID_KEY_VERSION=1

# Usados apenas pelo dispatcher interno. Nunca exponha no frontend.
SUPABASE_SECRET_KEY=
NOTIFICATION_DISPATCH_TOKEN=
NOTIFICATION_DISPATCH_BATCH_SIZE=50
NOTIFICATION_DISPATCH_LEASE_SECONDS=300
NOTIFICATION_DISPATCH_WORKERS=10
NOTIFICATION_PUSH_TIMEOUT_SECONDS=10
ACHIEVEMENT_DISPATCH_BATCH_SIZE=10
ACHIEVEMENT_DISPATCH_LEASE_SECONDS=300
